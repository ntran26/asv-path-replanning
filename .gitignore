# Python bytecode caches: regenerated on every run, differ per interpreter.
__pycache__/
*.py[co]

# Local virtual environment (see asv-lidar/static_dynamic_obstacles/requirements.txt).
.venv/

# Bulky outputs kept on disk but not tracked (2026-11-22, revised 2026-11-23), to keep the
# repository small enough to browse. Files already tracked under these paths stay tracked; add a
# new one with `git add -f`. Every file untracked on 2026-11-22 is in commit 7e66c2bfa
# (asv-lidar/static_dynamic_obstacles/results/safety_dev/README.md). Model files, videos and
# references are tracked again since 2026-11-23.
